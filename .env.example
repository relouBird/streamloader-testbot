# ────────────────────────────────────────────────────────────────
#  .env — Environnement de TEST / DÉVELOPPEMENT LOCAL
# ────────────────────────────────────────────────────────────────

# ── Serveur ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=5101
APP_URL=http://localhost:5501

# ── API ─────────────────────────────────────────────────────────
API_URL=http://localhost:5102/api
X_BOT_SECRET=

# ── TELEGRAM TOKEN ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── IDENTITÉ TELEGRAM ───────────────────────────────────────────
# La photo doit être un fichier JPEG accessible par le processus Node.
TELEGRAM_BOT_NAME=StreamLoaders
TELEGRAM_BOT_DESCRIPTION=Télécharge des vidéos rapidement et gratuitement.
TELEGRAM_BOT_SHORT_DESCRIPTION=Téléchargeur de vidéos rapide et gratuit.
TELEGRAM_BOT_PROFILE_PHOTO=
TELEGRAM_BOT_WELCOME_PHOTO=
TELEGRAM_BOT_WELCOME_TITLE=StreamLoaders
TELEGRAM_BOT_WELCOME_TEXT=Envoie-moi le lien d'une vidéo pour commencer.
